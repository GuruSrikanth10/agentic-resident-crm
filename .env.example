# ==========================================
# Agentic Resident CRM Example Environment Variables
# ==========================================

# --------------------------
# Deployment
# --------------------------
# "prod" enables stricter startup checks (e.g. rejects the default API key).
ENV=dev

# --------------------------
# Application Features
# --------------------------
ENABLE_LOG_FETCHING=true
ENABLE_LOG_FILTER_AGENT=false
USE_MOCK_DB=true
# Path to the rules export used when USE_MOCK_DB=true.
# Defaults to src/db/mock_db.xlsx when unset.
MOCK_DB_PATH=

# --------------------------
# Live Database Configuration
# --------------------------
DB_USERNAME=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# --------------------------
# Elasticsearch Configuration
# --------------------------
ES_HOST=
ES_USERNAME=
ES_PASSWORD=
ES_INDEX_PATTERN=logs-*
# Comma-separated application_name values to fetch. Empty means no app
# restriction at all. Was hardcoded to a single service, which made every
# other service's logs unreachable regardless of where the packet failed.
#
# A refId passes through several services, and the logs that explain a failure
# are rarely confined to one of them -- list every service the packet touches.
# Since 2026-08-21 this ALSO drives Kubernetes pod discovery (see
# K8S_APP_NAMES below), so one list configures both sources and they cannot
# drift into searching different parts of the packet's journey.
ES_APP_NAMES=enu-biometric
# Optional @timestamp lower bound, in days, to stop each fetch scanning the
# whole index pattern. Deliberately NOT tied to K8S_DEFAULT_SINCE_HOURS:
# Elasticsearch is the system of record and investigations routinely run long
# after the event (consumer lag, DLQ replays, checkpoint resumes), so a short
# window here would silently drop the evidence those paths exist to recover.
# Unset = unbounded.
ES_SEARCH_WINDOW_DAYS=
# Reject self-signed/untrusted TLS certs unless explicitly disabled.
ES_VERIFY_CERTS=true
ES_REQUEST_TIMEOUT_SECONDS=30
# Hard cap on documents pulled per event during Stage 1 pagination.
LOG_MAX_DOCUMENTS=50000
# Cap on decision-vocabulary matches kept in the reduced trace. These are kept
# in FULL TEXT, and the default vocabulary matches strings ("packet status",
# "rejected") that appear on most lines in this domain -- so unbounded, 20k raw
# lines produced 20k full lines, ~285k tokens, in a call with a 60s timeout.
# The first and last half are kept and the omission is stated in the output.
LOG_MAX_DECISION_LINES=300
# Last-resort ceiling on the whole reduced string handed to the LLM. The
# per-section bounds cap the parts; this caps the total, and exists for the
# ERROR branch in particular, which is bounded in lines and not in characters.
LOG_MAX_REDUCED_CHARS=120000
# Path to a local Kibana CSV export -- when set, fetch_logs() reads from
# this file instead of calling Elasticsearch (for offline testing).
# UNCHANGED by the Kubernetes log source work; this remains the ES mock.
ES_MOCK_FILE=

# --------------------------
# Kubernetes Log Source (KUBERNETES_LOGS_PLAN.md)
# --------------------------
# Ordered fallback chain. Default is Kubernetes-first, Elasticsearch as
# fallback: pod logs are the more complete source for the recent window,
# Elasticsearch covers the long tail and whatever the cluster no longer has.
# With no cluster config below, the Kubernetes leg fails fast (no namespace
# configured) and every fetch falls straight through to Elasticsearch --
# functionally identical to pre-Kubernetes-source behaviour until
# KUBECONFIG_PATH / K8S_DEFAULT_NAMESPACE are filled in.
# Values: kubernetes,elastic | elastic,kubernetes | elastic | kubernetes
LOG_SOURCE=kubernetes,elastic

# Cluster connectivity. In-cluster config is attempted first; these are the
# fallback for a remote cluster. Keep the kubeconfig OUTSIDE this repository.
KUBECONFIG_PATH=
K8S_CONTEXT=

# Which namespace/service to read. The RBAC-scoped ServiceAccount can only
# list pods within a known namespace -- it cannot list namespaces or pods
# cluster-wide -- so the namespace must always be resolved up front. Default
# pod matching is `name_contains` (client-side substring match on pod name,
# no label_selector sent), since real deployments here don't guarantee
# consistent labels. K8S_SERVICE_MAP overrides per app, e.g.
# {"enu-biometric": {"namespace": "enu", "name_contains": "enu-biometric"}}
# Set "label_selector" instead of "name_contains" to opt into server-side
# label matching for a service that does have reliable labels, e.g.
# {"enu-biometric": {"namespace": "enu", "label_selector": "app=enu-biometric"}}
K8S_DEFAULT_NAMESPACE=
K8S_DEFAULT_APP=enu-biometric
K8S_SERVICE_MAP=

# Every service to search, comma-separated. Each resolves its own namespace
# and match spec through K8S_SERVICE_MAP, and the results are merged.
#
# Leave this EMPTY to inherit ES_APP_NAMES, which is the intended setup: one
# list, both sources. Set it only when the two genuinely must differ, because
# a Kubernetes pod-name substring and an Elasticsearch `application_name`
# value are not always the same string.
#
# Two things worth knowing before adding names here:
#   - Matching is a SUBSTRING test, so "enu-biometric" also matches the pods
#     of "enu-biometric-abis-mw-consumer". Overlapping names are deduped
#     (a pod is never read twice), so this is safe -- but a broad name may
#     quietly pull in more pods than you expect. Check the "Kubernetes pods
#     discovered" log line's pod_count per app.
#   - A service that cannot be searched (namespace unreadable, RBAC denied)
#     does NOT fail the fetch. The others still return logs and a
#     SERVICE_UNAVAILABLE evidence gap names the missing one, so the agent
#     knows that hop is absent rather than silent.
# Unset entirely, this falls back to the single K8S_DEFAULT_APP above.
K8S_APP_NAMES=

# Fan-out, bounds, and timeouts.
# K8S_MAX_PODS applies PER SERVICE, so adding a service never shrinks another
# service's representation. Total fan-out is therefore K8S_MAX_PODS x the
# number of services searched.
K8S_MAX_PODS=20
# Optional ceiling on distinct pods across ALL services. 0 disables it, which
# is the default: the per-service cap above already bounds each service, and
# K8S_FETCH_CONCURRENCY / K8S_TOTAL_FETCH_TIMEOUT_SECONDS bound the real cost.
# When it does bind, pods are trimmed round-robin so every service keeps
# representation rather than the last-configured one being dropped whole.
K8S_MAX_TOTAL_PODS=0
K8S_MAX_BYTES_PER_POD=10485760
K8S_FETCH_CONCURRENCY=5
K8S_REQUEST_TIMEOUT_SECONDS=30
# Wall-clock budget for the whole multi-pod fetch. Kept well under
# AGENT_INVOKE_TIMEOUT_SECONDS so a slow cluster degrades to partial results
# plus a TRUNCATED gap rather than consuming the packet's entire budget.
K8S_TOTAL_FETCH_TIMEOUT_SECONDS=60
# Identifier matching and context windows.
K8S_DEFAULT_SINCE_HOURS=2
K8S_SEARCH_FIELDS=eventId,refId
K8S_CONTEXT_LINES_BEFORE=5
K8S_CONTEXT_LINES_AFTER=20
K8S_LEVEL_PARSE_WARN_THRESHOLD=0.9
K8S_SIDECAR_DENYLIST=istio-proxy,linkerd-proxy,vault-agent

# TLS. Verification defaults on; disabling it is an explicit, logged choice.
K8S_VERIFY_SSL=true
K8S_CA_CERT_PATH=

# PII redaction. Applied after identifier filtering and before anything is
# persisted, so unredacted resident data never reaches disk or S3.
# Extra patterns are regexes separated by ||| .
K8S_REDACT_ENABLED=true
K8S_REDACT_EXTRA_PATTERNS=

# Offline fixture directory for the Kubernetes source only. Strictly
# additive -- has no effect on ES_MOCK_FILE or the Elasticsearch path.
K8S_FIXTURE_DIR=

# Single flat log file to read INSTEAD of calling the Kubernetes API, for a
# machine with no cluster access. Replaces the transport only: identifier
# matching, context windows, parsing, redaction, gap detection and the whole
# reduction pipeline (Stages 2-4) run exactly as they do live, so two event
# ids read from one file still return different record counts.
#
# Accepts the pipeline's own rendered form, so a reduced_logs.txt or a trace
# pasted out of a casebook can be fed straight back in:
#     [<timestamp>] [<app>@<pod>] [<LEVEL>] [context] <message>
# and falls back to raw kubelet / kubectl output for anything else.
# Unlike K8S_FIXTURE_DIR this skips pod discovery entirely.
K8S_MOCK_LOG_FILE=

# App/pod attribution for mock lines that carry none of their own.
K8S_MOCK_APP_NAME=mock-service
K8S_MOCK_POD_NAME=mock-file

# Whether to drop mock records outside the requested look-back. Off by
# default: a captured trace is replayed long after its timestamps, and
# windowing it would return zero records and present that as a successful
# empty fetch. Turn on only when the window itself is what you are testing.
K8S_MOCK_APPLY_WINDOW=false

# --------------------------
# LLM Configuration
# --------------------------
# Toggle to use HuggingFace (true) or OpenAI-compatible endpoint (false)
USE_HF=false
# Toggle to use the Mistral API instead of a local/proxy OpenAI-compatible endpoint
MOCK_LLM_WITH_MISTRAL=false
# Per-request timeout for both the OpenAI-compatible and Mistral clients.
LLM_TIMEOUT_SECONDS=60

# --- Local / Proxy Configs ---
LLM_MODEL_COMPLEX=glm-5.2-fp8
LLM_BASE_URL_COMPLEX=http://localhost:8000/v1
LLM_API_KEY_COMPLEX=dummy

LLM_MODEL_SIMPLE=Qwen/Qwen3-VL-235B-A22B-Instruct-FP8
LLM_BASE_URL_SIMPLE=http://localhost:8000/v1
LLM_API_KEY_SIMPLE=dummy

# --- Mistral Configs (used when MOCK_LLM_WITH_MISTRAL=true) ---
MISTRAL_MODEL_COMPLEX=mistral-large-latest
MISTRAL_MODEL_SIMPLE=mistral-small-latest

# --- HuggingFace Fallback Configs ---
HF_TOKEN=your_huggingface_token_here
HF_MODEL_COMPLEX=THUDM/glm-4-9b-chat
HF_MODEL_SIMPLE=Qwen/Qwen3-VL-235B-A22B-Instruct-FP8

# --------------------------
# Kafka Configuration
# --------------------------
# Fetching (Kubernetes/Elasticsearch) is decoupled from LLM analysis so the
# slow LLM stage can never stall log collection: two topics, two independent
# consumer processes (src/fast_consumer.py, src/slow_consumer.py), two
# "dumb" API routes. See ARCHITECTURE.md section 3.11.
#
#   fast_consumer.py: rejections topic -> POST /fetch-logs
#     Fetches logs, persists them, republishes the payload onto the
#     analysis queue. Bounded I/O only -- scale this down, or run few pods.
#   slow_consumer.py: analysis-queue topic -> POST /analyze-rejection
#     Runs runbook_lookup then, on a miss, the LLM investigation loop.
#     Scale this OUT (many pods) to absorb LLM latency/backlog.
#
# Both share KAFKA_CONSUMER_BROKERS; everything else below is per-role so a
# single shared .env (e.g. under start.py's single-host supervisor) can
# configure them independently. In a split-pod deployment each role's own
# Deployment manifest sets only the variables it reads.

KAFKA_CONSUMER_BROKERS=localhost:9092

# --- Fast consumer (rejections -> /fetch-logs) ---
KAFKA_CONSUMER_TOPIC_NAME=rejections
KAFKA_CONSUMER_GROUP_ID=rejection-agents-group
KAFKA_CONSUMER_INTERNAL_ENDPOINT=http://localhost:8000/fetch-logs
# Budget for a single log-fetch call -- bounded I/O, not an LLM call, so this
# is deliberately much shorter than PACKET_TIMEOUT_SECONDS below.
FAST_CONSUMER_TIMEOUT_SECONDS=90
# Serves GET /health for this process alone. Optional; unset disables it
# (fine for start.py's single-host setup, where the API's own /health
# already reports both consumers' heartbeats).
CONSUMER_HEALTH_PORT=

# --- Slow consumer (analysis queue -> /analyze-rejection) ---
# Must match PACKET_ANALYSIS_TOPIC_NAME below -- that's what POST
# /fetch-logs publishes onto, and what this consumer reads from.
SLOW_CONSUMER_TOPIC_NAME=packet-analysis-queue
SLOW_CONSUMER_GROUP_ID=packet-analysis-group
SLOW_CONSUMER_ENDPOINT=http://localhost:8000/analyze-rejection
SLOW_CONSUMER_HEALTH_PORT=
# How long the slow consumer's HTTP client waits for /analyze-rejection to
# respond -- i.e. the LLM investigation budget. Same variable, same meaning
# this had before the fetch/analyze split.
PACKET_TIMEOUT_SECONDS=300

# --- Analysis queue producer (read by POST /fetch-logs in the API) ---
PACKET_ANALYSIS_TOPIC_NAME=packet-analysis-queue

# Tuning for slow, AI-driven workloads to prevent consumer rebalances.
# Limits records per poll to avoid blocking the main thread, and increases the
# timeout budget before Kafka assumes the consumer has died. Shared by both
# consumers here for convenience; override per-pod in production if the fast
# consumer's much shorter processing time warrants a smaller
# KAFKA_MAX_POLL_INTERVAL_MS than the slow consumer needs.
KAFKA_MAX_POLL_RECORDS=5
KAFKA_MAX_POLL_INTERVAL_MS=900000

# --------------------------
# Resilience & Hardening Configuration
# --------------------------
# Maximum LLM debate loops before escalating to human
MAX_INVESTIGATION_RETRIES=3

# Bounded worker pool size. Read independently by each process: each Kafka
# consumer (fast and slow alike) sizes its own worker pool from this, and the
# API sizes its agent.invoke() executor from it too -- set it per-pod in
# production, since the fast consumer, the slow consumer, and the API
# typically want very different values here.
MAX_CONCURRENT_INVESTIGATIONS=5

# How long an IN_PROGRESS status.json is trusted before being treated as stale.
MAX_IN_PROGRESS_AGE_SECONDS=1800

# Server-side budget for a single agent.invoke() call. Defaults to
# PACKET_TIMEOUT_SECONDS - 30s if unset; only set this to override that.
# AGENT_INVOKE_TIMEOUT_SECONDS=270

# How long a rule lookup is cached before being re-fetched from the DB.
RULE_CACHE_TTL_SECONDS=600

# Casebook storage mechanism: 'local' (atomic lock) or 's3'.
# 'local' uses filelock, which does NOT coordinate across pods -- running more
# than one API replica requires 's3' plus CHECKPOINT_BACKEND=postgres, and
# boot validation enforces that when API_REPLICA_COUNT > 1.
CASEBOOK_STORAGE_BACKEND=local
CASEBOOK_S3_BUCKET=
CASEBOOK_S3_PREFIX=casebooks
# How many times an atomic read-modify-write (DLT group counters) re-reads and
# retries after losing an S3 conditional write to a competing pod. Contention
# is only between the pods analysing the same fingerprint at once.
S3_UPDATE_MAX_ATTEMPTS=8

# Declared replica count. Only used by boot validation to reject a
# multi-replica deployment sitting on single-node storage.
API_REPLICA_COUNT=1

# LangGraph checkpoint store: 'sqlite' (local file) or 'postgres' (shared).
# A local SQLite file cannot be shared between pods, so a packet checkpointed
# by one replica cannot be resumed by another.
CHECKPOINT_BACKEND=sqlite
# Required when CHECKPOINT_BACKEND=postgres. Needs langgraph-checkpoint-postgres.
CHECKPOINT_POSTGRES_URI=
# Required when CASEBOOK_STORAGE_BACKEND=s3, or when a reduced log payload
# is too large to embed inline in the casebook. Left unset, oversized logs
# are truncated and embedded inline instead of a broken s3:// URL.
S3_LOGS_BUCKET=

# Kafka Dead Letter Queue for pipeline drops
KAFKA_DLQ_TOPIC=rejected-packets-dlq

# API Key for securing FastAPI endpoints
AGENTIC_RESIDENT_CRM_API_KEY=your-secure-api-key-here

# Requests per minute per client IP. Defaults to MAX_CONCURRENT_INVESTIGATIONS
# x 20 (min 60). The old fixed limit of 10 throttled this system's own
# consumer, which forwards every packet from a single IP.
# RATE_LIMIT_PER_MINUTE=100
# Callers exempt from rate limiting -- the consumer lives here.
RATE_LIMIT_EXEMPT_CIDRS=127.0.0.0/8,::1/128
# Proxies whose X-Forwarded-For is trusted. Empty means never trust it;
# without this, behind an ingress every caller shares one rate-limit bucket.
TRUSTED_PROXY_CIDRS=

# --------------------------
# Shutdown & Health
# --------------------------
# How long in-flight investigations get to finish on SIGTERM. Keep below the
# pod's terminationGracePeriodSeconds so the drain completes before SIGKILL.
SHUTDOWN_DRAIN_SECONDS=25
# How long one attempt to take a worker slot waits before the poll loop
# re-checks for a shutdown. The acquire used to be untimed, so with every
# worker busy a SIGTERM was not observed until a packet finished -- up to
# PACKET_TIMEOUT_SECONDS, long past the grace period.
SLOT_ACQUIRE_POLL_SECONDS=1
# Consumer heartbeat cadence. Written by a dedicated thread, so it keeps
# ticking while the poll loop is blocked on the concurrency semaphore.
HEARTBEAT_INTERVAL_SECONDS=5

# Retries for the atomic heartbeat swap. On Windows `os.replace` is denied
# while another process (OneDrive, the search indexer, an AV scan) holds the
# destination open; those release in milliseconds, so a few retries absorb it
# instead of logging a warning per tick.
# HEARTBEAT_WRITE_ATTEMPTS=3
# HEARTBEAT_WRITE_BACKOFF_SECONDS=0.1

# The same retry, for every durable write that is not the heartbeat --
# casebooks, status files, log artifacts, runbooks. A larger budget than the
# heartbeat's because nothing repeats these writes: the final failure is
# raised, and for a casebook that means the packet goes to the DLQ.
# ATOMIC_REPLACE_ATTEMPTS=5
# ATOMIC_REPLACE_BACKOFF_SECONDS=0.1

# --------------------------
# Logging & Observability
# --------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Casebooks and their log artifacts. Override for a mounted data volume.
# LOCAL_CASESHEETS_DIR=
# Checkpoint DB, heartbeats, drain3 state and the template catalog. Override
# to keep these off a synced or indexed directory -- a checkout under Windows
# `Documents`/OneDrive means an external process holds handles on files this
# one rewrites every few seconds.
# LOCAL_CHECKPOINTS_DIR=

# --------------------------
# Outcome Loop (ENHANCEMENT_PLAN.md 4.1)
# --------------------------
# Operators record whether a resolution was actually correct via
# `python3 -m src.tools.record_outcome` or POST /outcome/{event_id}, and read
# accuracy back with `python3 -m src.tools.accuracy_report`. Without those
# verdicts there is no accuracy figure, so runbooks cannot be safely promoted
# and agent regressions are invisible. No configuration needed.

# --------------------------
# Runbook Pipeline (RUNBOOK_PLAN.md)
# --------------------------
# off: normal pipeline. shadow: compare but don't serve. serve: short-circuit agents.
RUNBOOK_MODE=off
# In-process cache TTL for loaded runbooks
RUNBOOK_CACHE_TTL_SECONDS=600
# Comma-separated reason codes cleared to actually short-circuit the agents
# under RUNBOOK_MODE=serve. Empty means no per-code restriction (all served).
# Promote a code onto this list only once `accuracy_report` shows its runbook
# matching agent accuracy in shadow mode -- codes not listed keep running the
# agents and are shadow-compared, which is how they earn their place.
RUNBOOK_SERVE_ALLOWLIST=

# --------------------------
# Synthesis Contract & Confidence (ENHANCEMENT_PLAN.md 4.3, 4.4)
# --------------------------
# Below this confidence the resolution is routed to MANUAL_REVIEW instead of
# being acted on. Default 0 = disabled: a confidence score nobody has
# calibrated is worse than none, so enable this only after accuracy_report
# shows what a given confidence is actually worth.
SYNTHESIS_CONFIDENCE_THRESHOLD=0
# Highest confidence allowed when the trace carries evidence gaps. Not a
# calibrated number but a safety property: part of the window was unreadable,
# so a higher confidence is unsupported by construction.
SYNTHESIS_GAP_CONFIDENCE_CEILING=0.6

# --------------------------
# Replay Pipeline (Human-in-the-Loop)
# --------------------------
OIS_FEIGN_BASE_URL=http://10.10.79.62:31261/ois/hold/v1
ENABLE_AUTO_REPLAY=false
# Sent as an X-API-Key header on replay calls to OIS_FEIGN_BASE_URL, if set.
OIS_API_KEY=

# --- DLT auto-replay (src/dlt/auto_replay.py) ---
# Whether /analyze-dlt may itself call queue_for_replay on a high-confidence
# redrive finding. Independent of ENABLE_AUTO_REPLAY above, which still
# governs what queue_for_replay does once called: true posts straight to
# OIS, false (the safer default) queues for a human to approve via
# approve_replays.py. Turning this on with ENABLE_AUTO_REPLAY left off means
# "let the DLT lane nominate packets, but still make a human press the
# button" -- reach for that combination before enabling both.
#
# Off by default: DLT_PLAN.md's own non-goals rule out remediation for v1,
# and this is the one deliberate, scoped exception to that.
DLT_AUTO_REPLAY_ENABLED=false

# Only a finding whose action is REDRIVE_AFTER_RECOVERY (extend via
# DLT_REPLAY_ACTIONS below) AND whose confidence is at or above this can
# trigger a replay. Canned Class B/C/U findings never qualify -- canned.py
# never attaches a confidence to one, since no model produced it, and a
# missing confidence never reads as a passing number.
#
# Default sits just under DEFAULT_CONTRADICTED_CEILING (0.6, in
# src/models/dlt_synthesis.py): the only realistic way to reach a
# non-null-confidence REDRIVE_AFTER_RECOVERY is a CONTRADICTED corroboration
# verdict (the declared business exception wasn't the real story; the logs
# pointed at something transient instead), and that verdict caps confidence
# at 0.6. A threshold at or above that ceiling would make this feature
# permanently inert.
DLT_REPLAY_CONFIDENCE_THRESHOLD=0.55

# Comma-separated DLT_ACTIONS values that mean "replay is the fix". Extends
# (replaces, if set) the built-in default of REDRIVE_AFTER_RECOVERY --
# DATA_FIX_REQUIRED is deliberately excluded: a data-not-found packet's row
# is still missing after a replay, since nothing about the row changed just
# because time passed. Add a code-specific "known automated remediation"
# action here once one exists.
DLT_REPLAY_ACTIONS=REDRIVE_AFTER_RECOVERY

# The rejection flow always calls queue_for_replay with id=eventId. A DLT
# case has no eventId -- only refId, the same identifier used for log
# correlation. Whether OIS's /forceReplay endpoint accepts a bare refId, and
# what idType/category/priority/fromSedaStart it expects for a
# DLT-originated redrive, has NOT been confirmed against the real endpoint.
# These four are placeholders -- confirm them with ops before relying on
# DLT_AUTO_REPLAY_ENABLED=true with ENABLE_AUTO_REPLAY=true together.
DLT_REPLAY_ID_TYPE=REFID
DLT_REPLAY_OPERATOR_NAME=dlt-analysis-auto
DLT_REPLAY_CATEGORY=DLT_REDRIVE
DLT_REPLAY_PRIORITY=5
DLT_REPLAY_FROM_SEDA_START=false

# --------------------------
# DLT Analysis -- Phase 1 (DLT_PLAN.md section 8)
# --------------------------
# A parallel flow to the rejection pipeline: consumes a dead-letter topic,
# fingerprints the failure from its stacktrace, and writes an advisory
# casebook. Nothing here is read until the DLT consumer exists (Phase 4).

# Java package prefixes treated as application code. Frames outside these are
# framework/JDK noise and are dropped before fingerprinting -- the reference
# sample's chain holds 60+ frames, of which 9 are application frames.
DLT_APP_PACKAGES=com.uidai.,in.gov.uidai.
# How many normalised application frames enter the fingerprint. Lower groups
# more aggressively; higher splits groups that share a call path.
DLT_FINGERPRINT_FRAMES=5
# Application frames that are exception *plumbing* rather than failure sites.
# CommonErrorFactory constructs every BusinessException in the codebase, so the
# frame is identical across all Class A failures: it adds no discriminating
# power and displaces the frame that names the real failure site. Set to an
# empty value to disable the filter (this shifts every fingerprint).
DLT_BOILERPLATE_FRAMES=in.gov.uidai.common.factory.CommonErrorFactory
# Whether the payload's `__TypeId__` is a fingerprint dimension.
#
# Leave it off while the DLT carries one payload structure. Turn it on with
# the SECOND original topic: two topics failing in a shared library or a
# common consumer base class share a root exception, a business code and their
# top application frames, so they collapse into one group -- and a group's
# recommendation is re-served verbatim, describing the first topic's payload
# against the second topic's records.
#
# Turning it on re-hashes every failure mode: live groups fragment once,
# occurrence counts restart from zero and stored recommendations are orphaned.
# That is the one-time cost of the split, and it is why this is a deployment
# decision rather than a default.
DLT_FINGERPRINT_TYPE_ID=false

# --- DLT Analysis -- Phase 2 (classification and registry) ---
# JSON object of exception-FQCN prefix -> failure class (A/B/C/U). This
# EXTENDS the built-in map rather than replacing it, so adding one entry does
# not silently drop the other forty. Longest matching prefix wins.
DLT_CLASS_MAP=
# Exception types treated as business errors. Any FQCN ending in
# "BusinessException" already qualifies regardless of this setting.
DLT_BUSINESS_EXCEPTIONS=in.gov.uidai.common.exception.BusinessException
# The reason-code catalog: code -> description, category and failure class.
# Generated from reason_codes.txt (the BusinessReasonCode Java source) by
#   python -m src.tools.parse_reason_codes
# Relative paths resolve against the repo root. A missing or malformed file is
# a lookup miss, never an error -- it lowers a finding's confidence instead of
# dropping the packet, and classification falls back to the stacktrace alone.
# A two-column code,description file from before the catalog existed still
# loads; it simply carries no category.
DLT_REGISTRY_PATH=reason_codes.csv

# Whether a catalog category may override the stacktrace-based failure class.
# On by default. It only ever moves a case from A to C, never the reverse and
# never to B: 198 of the published reject codes are declared
# TECHNICAL_EXCEPTION, and they arrive wrapped in a BusinessException that
# would otherwise read as a business failure and cost an LLM call to reach the
# answer "redrive once the dependency recovers". Set false to classify from
# the exception type alone.
DLT_REASON_CODE_CLASSIFY=true

# --- DLT Analysis -- Phase 3 (payload identifier and case identity) ---
# The refId is resolved in four layers, first hit wins:
#
#   1. the Kafka record key      -- primary; the 2026-08-20 sample is keyed on
#                                   the refId, and the key survives a payload
#                                   we cannot deserialise
#   2. DLT_REFID_PATH            -- a global override, below
#   3. the path registered for the payload's __TypeId__ (see
#      src/models/dlt_payload_schemas.py, or DLT_REFID_PATHS_BY_TYPE below)
#   4. a bounded breadth-first search for DLT_REFID_KEYS
#
# Nothing here needs setting for the two known payload types. Run
# `python -m src.tools.dlt_sample --analyze <corpus>` to see which layer is
# actually resolving your traffic and whether key and payload ever disagree.

# Global dotted path override, e.g. packetMetaData.refId. Numeric segments
# index into lists (events.0.refId). Applies to every __TypeId__, so prefer
# DLT_REFID_PATHS_BY_TYPE unless one path genuinely fits all of them.
DLT_REFID_PATH=

# Per-__TypeId__ paths, as JSON. Overrides the built-in registry, so a path
# that moves in production is a restart rather than a release. A value may be
# one path or an ordered list of them. Malformed JSON is ignored with a
# warning rather than raising -- a typo here must not take the consumer down.
#   {"in.gov.uidai...EnrolmentEventResponse": "abisMWResponseNewSeda.refId"}
DLT_REFID_PATHS_BY_TYPE=

# Keys the fallback search looks for, in priority order. `event_id`, `eventId`,
# `candidateRefId` and `requestId` are denied and silently stripped if added
# here: the EnrolmentEventResponse payload carries an `event_id` that is a
# DIFFERENT uuid from the refId, and a `candidateRefId` belongs to a different
# enrolment entirely. Either would correlate to no log line, or to the wrong
# packet's -- and would fail as an empty log window, not as an error.
DLT_REFID_KEYS=refId,ref_id,referenceId

# --- DLT Analysis -- Phase 4 (consumers) ---
# Master switch for start.py's single-host supervisor. Off by default: a
# deployment with no dead-letter topic would otherwise start consumers that
# fail to subscribe, and the supervisor tears down everything when a child
# exits. In a split-pod deployment each role's manifest runs its own
# entrypoint and this is irrelevant.
DLT_ENABLED=false

# DLT consumer (dead-letter topic -> /fetch-dlt-logs). Bounded I/O, no LLM.
DLT_CONSUMER_TOPIC_NAME=packet-dlt
DLT_CONSUMER_GROUP_ID=dlt-analysis-group
DLT_CONSUMER_ENDPOINT=http://localhost:8000/fetch-dlt-logs
DLT_CONSUMER_TIMEOUT_SECONDS=90
DLT_HEALTH_PORT=

# DLT analysis consumer (DLT analysis queue -> /analyze-dlt). LLM-bound;
# this is the role to scale out.
DLT_ANALYSIS_TOPIC_NAME=dlt-analysis-queue
DLT_ANALYSIS_GROUP_ID=dlt-analysis-slow-group
DLT_ANALYSIS_ENDPOINT=http://localhost:8000/analyze-dlt
DLT_ANALYSIS_TIMEOUT_SECONDS=300
# Server-side budget for one /analyze-dlt investigation, mirroring
# AGENT_INVOKE_TIMEOUT_SECONDS on the rejection lane. Defaults to
# DLT_ANALYSIS_TIMEOUT_SECONDS minus 30s so the API gives up just BEFORE the
# consumer does -- otherwise the consumer writes FAILED_TIMEOUT and DLQs the
# message while the API keeps running and later overwrites that verdict.
# DLT_ANALYZE_TIMEOUT_SECONDS=270
# Worker pool for the DLT analysis lane. A sibling of the rejection lane's
# executor, not a share of it, so a DLT backlog cannot starve rejections.
# Defaults to MAX_CONCURRENT_INVESTIGATIONS.
# MAX_CONCURRENT_DLT_ANALYSES=5
DLT_ANALYSIS_HEALTH_PORT=

# --- DLT Analysis -- Phase 5 (log window) ---
# The window is anchored on retry_topic-backoff-timestamp (when the LAST
# attempt failed), not kafka_original-timestamp. In the reference sample those
# are 43 hours apart, so the wrong anchor searches a stale window and returns
# nothing with no error anywhere.
DLT_LOG_LEAD_SECONDS=300
DLT_LOG_TRAIL_SECONDS=120
# Beyond this age the fetch is skipped and a LOGS_TOO_OLD gap recorded. A
# fetch certain to return nothing still costs a full Kubernetes fan-out over
# every pod in the namespace.
DLT_MAX_LOG_AGE_SECONDS=86400

# --- DLT replay precheck -- Phase C1 (deployed version) ---
# How long a reading of the pods' running image version is reused before it is
# re-read. The deployed version changes on a deploy cadence, not a per-message
# one, so at ~2,000 messages/day this collapses the whole day's traffic into
# roughly one Kubernetes call a minute. Set to 0 to disable caching entirely.
#
# This capture is NOT behind a feature flag: it answers DLT_PLAN.md Open
# Question 3 and mitigates Risk R4 on its own, independently of the code check
# that will later consume it. A failed reading is never cached, so a transient
# blip does not hold a whole TTL of cases at an unknown version.
DLT_DEPLOYED_VERSION_TTL_SECONDS=60

# --- DLT replay precheck -- Phase C3 (version algebra) ---
# Optional. The parser expects the version at the FRONT of the tag
# (`1.0.0-release.42`, `1.0.1-SNAPSHOT`, `1.0.0`), which covers every shape
# seen so far. A team that tags `enu-biometric-1.0.0` or `release-1.0.0`
# instead would otherwise get an UNKNOWN verdict on every case; this makes
# that a config change rather than a code change.
#
# Must contain a (?P<version>...) group. A pattern that does not compile, or
# has no such group, is logged once and ignored -- a broken override degrades
# to the default parser rather than refusing every version in the system.
#
#   DLT_VERSION_PATTERN=^enu-biometric-(?P<version>.+)$
DLT_VERSION_PATTERN=

# --- DLT replay precheck -- Phase C4 (Bitbucket adapter) ---
# READ-ONLY access to the source repository. The token needs nothing beyond
# repository read on the repos named in DLT_REPO_MAP: the adapter makes four
# kinds of call (list commits touching a path, list a commit's changed paths,
# fetch a file, list files) and has no code path that writes.
#
# Leave BITBUCKET_BASE_URL empty to disable every source lookup outright --
# the code check then reports UNKNOWN and the DLT lane behaves exactly as it
# did before this feature existed.
BITBUCKET_BASE_URL=
BITBUCKET_TOKEN=
# Only for Bitbucket Cloud app passwords, which use Basic auth. Left empty,
# BITBUCKET_TOKEN is sent as a Bearer header, which is what Server/DC PATs
# expect.
BITBUCKET_USERNAME=
# `server` (Bitbucket Server / Data Center, /rest/api/1.0) or `cloud`
# (/2.0). Left empty, a bitbucket.org host is detected as cloud and anything
# else as server. Phase C0's Q1 answers this; set it explicitly once known.
BITBUCKET_API_FLAVOUR=
BITBUCKET_TIMEOUT_SECONDS=20

# Java package prefix -> repository. Longest prefix wins, the same idiom as
# DLT_CLASS_MAP. A frame in an UNMAPPED package resolves to nothing and yields
# UNKNOWN -- deliberately, because a fix in the shared `in.gov.uidai.common`
# library is a dependency bump in the service's pom, not a commit on the
# service's release branch (Trap T8).
#
# `source_roots` is tried in order and is what makes a multi-module repo a
# config change rather than a code one. Omit it and the adapter falls back to
# listing the repository, which works on Server only.
#
#   DLT_REPO_MAP={"com.uidai.enu.biometric": {"project": "ENU", "repo": "enu-biometric", "branch": "release", "version_file": "pom.xml", "source_roots": ["src/main/java"]}}
#
# MULTI-MODULE REPOSITORIES. `version_file` is per ENTRY, not per module, and
# the entry that matters is the one whose pom version matches the IMAGE TAG --
# often a module pom, not the root one, whose version is frequently the parent
# version or a `${revision}` placeholder. Modules normally have distinct
# package prefixes, so give each its own entry; longest prefix wins, the same
# as DLT_CLASS_MAP:
#
#   DLT_REPO_MAP={
#     "com.uidai.enu.biometric.service": {"project":"ENU","repo":"enu-biometric",
#        "version_file":"biometric-service/pom.xml",
#        "source_roots":["biometric-service/src/main/java"]},
#     "com.uidai.enu.biometric.api":     {"project":"ENU","repo":"enu-biometric",
#        "version_file":"biometric-api/pom.xml",
#        "source_roots":["biometric-api/src/main/java"]}}
#
# Run `code_check_probe --layout` FIRST. Its Q5 reports the pom count and the
# source roots, which is what tells you which pom the image is tagged from.
#
# `version_file` may also be a `.properties` / `.props` file (`version=` or
# `revision=`), for a build that keeps the shipped number outside the pom.
DLT_REPO_MAP=

# --- DLT replay precheck -- Phase C5 (the verdict) ---
# The FIRST of two independent switches. This one decides whether the lookup
# happens at all and whether a verdict is written into the casebook. It
# changes NO replay behaviour -- that is DLT_CODE_CHECK_GATES_REPLAY (phase
# C6), deliberately not the same flag.
#
# Run this alone for a few weeks first. The verdicts it records against real
# cases are the evidence for turning the gate on, which is the same posture
# Open Question 2 takes for the mis-cast detector.
DLT_CODE_CHECK_ENABLED=false

# How many application frames of the CALL PATH to check. Every one of them is
# queried, not just the first that resolves.
#
# This matters more than it looks. An exception surfaces where bad data is
# USED, which is often several frames below where it was produced: a() passes
# something inconsistent to b(), which passes it to c(), which throws. A
# developer fixes a(). Checking only c() finds no commit and reports a
# confident, false NO_CHANGE -- withholding a replay that would now succeed.
#
# Distinct files are queried once, so the four frames the reference sample has
# inside BioDeDuplicationServiceImpl cost one lookup rather than four. Setting
# this to 1 restores failure-site-only checking, which is exactly the bug
# above.
DLT_CODE_CHECK_FRAMES=5

# Commits per file, and candidate commits resolved to a version. Both bound
# the fan-out when a busy file has a busy week.
DLT_CODE_CHECK_MAX_COMMITS=50
DLT_CODE_CHECK_MAX_CANDIDATES=10

# How long a Bitbucket read is reused. Every read is keyed on something that
# repeats within a fingerprint group -- a repo, a path, a commit id -- so this
# is what actually bounds API traffic at ~2,000 messages/day. A failed read is
# never cached, so an outage does not hold cases at UNKNOWN after recovery.
#
# WHILE TESTING, set this to 0. Otherwise a fix you push will not be visible
# to the code check for up to an hour, which looks exactly like the feature
# being broken.
DLT_CODE_CHECK_TTL_SECONDS=3600

# How long an EMPTY result is reused. Shorter on purpose, and never longer
# than the value above.
#
# An empty commit list is the answer that becomes NO_CHANGE and withholds a
# replay, so a stale one is the expensive kind of wrong: a fix landing minutes
# after a case was analysed would keep reading as "nothing has changed" for
# the rest of the window -- and `dlt_report --code-check-accuracy` cannot see
# it, because a withheld replay produces no outcome to measure. A non-empty
# result carries no such risk, so it keeps the full TTL.
DLT_CODE_CHECK_NEGATIVE_TTL_SECONDS=900

# A global branch override, for the case where every mapped repo shares one
# branch name. A per-repo `branch` in DLT_REPO_MAP still wins.
DLT_CODE_CHECK_BRANCH=release

# --- DLT replay precheck -- Phase C6 (the veto) ---
# The SECOND switch. With this off, a verdict is recorded and does nothing;
# with it on, NO_CHANGE and NOT_DEPLOYED withhold a replay that would
# otherwise have fired.
#
# It is a VETO ONLY. It can subtract a replay, never add one -- FIX_DEPLOYED
# does not rescue a finding the existing gate declined, and UNKNOWN changes
# nothing at all, which is what keeps a Bitbucket outage or an unmapped
# package from silently stopping every replay in the system.
#
# DO NOT ENABLE until DLT_CODE_CHECK_ENABLED has run for at least two weeks
# and the recorded verdicts have been checked against what replays actually
# did. This is the evidence bar DLT_PLAN.md Open Question 2 sets for the
# mis-cast detector, and this feature has the same "designed against a
# hypothesis" problem.
DLT_CODE_CHECK_GATES_REPLAY=false

# --- DLT replay precheck -- Phase C7 (parked replays) ---
# A replay withheld only because the fix has not deployed yet is parked, not
# dropped. `src/tools/release_parked_replays.py` releases it once the pods
# reach the version carrying the fix -- run it after a deploy or on a
# schedule. This is the part that turns "replay it and see" into "replay it
# after Thursday's deploy".
#
# Parking requires everything a replay requires EXCEPT the version, so it can
# never become a second replay path: with DLT_AUTO_REPLAY_ENABLED off, nothing
# parks. And releasing still calls queue_for_replay, so ENABLE_AUTO_REPLAY
# still decides whether the packet reaches OIS or lands in `pending_replays`
# for a human. Three switches deep, each meaning something different.
DLT_CODE_CHECK_PARK_ENABLED=false

# 30 days. A fix that never ships must not hold a packet forever; an expired
# entry is logged and marked, never silently dropped, and expiry beats release
# so a month-old packet is not replayed just because the version finally moved.
DLT_PARKED_REPLAY_TTL_SECONDS=2592000

# Ceiling on packets waiting at once. A queue nobody is watching must not grow
# without limit; parking past the cap is refused and logged.
DLT_PARKED_REPLAY_CAP=500

# --- DLT Analysis -- Phase 7 (groups and reuse) ---
# Cases retained per fingerprint group. occurrence_count keeps counting past
# the cap; at ~400 hits/day an uncapped list would grow without bound.
DLT_GROUP_MEMBER_CAP=200
# Master switch for recommendation reuse. Even when true, a cached answer is
# NEVER served blind: logs are always fetched and corroboration always runs,
# and only the LLM call is skipped. That is what keeps the mis-cast detector
# live on every occurrence.
DLT_REUSE_ENABLED=true

# --- DLT Analysis -- Phase 8 (findings and confidence) ---
# Ceilings compose by taking the minimum, and every one that binds is named in
# the casebook's ceilings_applied list so a capped score is auditable.
# Class B/U: no source access, so a narrative about *why* would be invention.
DLT_CLASS_B_CEILING=0.3
# Corroboration was UNVERIFIABLE -- the trace was never checked against logs.
DLT_UNVERIFIED_CONFIDENCE_CEILING=0.5
# Logs contradicted the trace: we know the declared cause is wrong, not what
# the right one is.
DLT_CONTRADICTED_CEILING=0.6
# A Class A code with no registry entry.
DLT_REGISTRY_MISS_CEILING=0.5
# Multiplier applied when a group's stored recommendation is reused.
DLT_REUSE_DECAY=0.95
# Reviewer rejection loop before synthesising anyway with a capped confidence.
DLT_MAX_INVESTIGATION_RETRIES=3
# Cap on log text handed to the analysis lane.
DLT_MAX_EVIDENCE_CHARS=40000
